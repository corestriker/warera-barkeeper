registry=https://registry.npmjs.org/

# Kein Git-Tag beim Versionssprung. "npm version patch" würde sonst v0.1.1 im
# Repo-Root setzen — und .github/workflows/release.yml baut aus jedem v*-Tag
# ein Release der Terminal-App. Der Sprung bleibt deshalb eine Änderung an
# package.json und dist/, die normal mitcommittet wird.
git-tag-version=false
