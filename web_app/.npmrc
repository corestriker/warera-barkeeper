# Dieses Projekt zieht seine Abhängigkeiten aus der öffentlichen Registry.
#
# Ohne diese Zeile gilt die Registry aus ~/.npmrc. Ist dort eine interne
# Registry eingetragen, landen deren Adressen in package-lock.json, und der
# GitHub-Runner scheitert beim Installieren mit „E401 Unable to authenticate":
# er hat dafür keine Zugangsdaten. Eine Projekt-Datei sticht die
# Benutzerdatei, deshalb steht sie hier.
registry=https://registry.npmjs.org/
